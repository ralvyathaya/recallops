# Browser: use "local" for the credential-free persistent demo, "cloud" after deployment.
NEXT_PUBLIC_API_MODE=local

# Local backend / scripts only. Production reads these values from Secrets Manager.
DATABASE_URL=postgresql://user:password@host:26257/recallops?sslmode=verify-full
DATABASE_NAME=recallops
EVIDENCE_BUCKET=recallops-evidence
AWS_REGION=us-east-1
BEDROCK_REASONING_MODEL=global.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
MCP_URL=https://cockroachlabs.cloud/mcp
MCP_CLUSTER_ID=replace-me
MCP_API_KEY=replace-me
SESSION_SECRET=replace-with-32-random-bytes
USE_MOCK_SERVICES=true
