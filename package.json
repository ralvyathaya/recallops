{
  "name": "recallops",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:watch": "tsx --test --watch test/**/*.test.ts",
    "test:e2e": "playwright test",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "deploy": "npm run build && cdk deploy",
    "db:init": "tsx scripts/db-init.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run cdk:synth"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.890.0",
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/client-secrets-manager": "^3.890.0",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "lucide-react": "^0.544.0",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.18.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "aws-cdk": "^2.1029.2",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.4.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "esbuild": "^0.25.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
